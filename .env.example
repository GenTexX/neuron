# Backend (apps/api) – alle Pflichtvariablen, ohne Defaults (§14.4).
#
# Kopiere diese Datei nach `apps/api/.env` (oder ins Repo-Wurzelverzeichnis) –
# die API sucht eine `.env` ab dem Arbeitsverzeichnis aufwärts. Bereits gesetzte
# Umgebungsvariablen haben Vorrang. In Produktion (Docker) kommt die
# Konfiguration ausschließlich aus der Umgebung.
DATABASE_URL=postgres://neuron:neuron@localhost:5432/neuron
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
BIND_ADDR=0.0.0.0:8080
STATIC_DIR=./apps/web/build
RUST_LOG=info,neuron_api=debug,tower_http=info
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional: Cookie ohne Secure-Flag für lokale http-Entwicklung
COOKIE_SECURE=false
# Optional: Proxy-Header für das Rate Limiting auswerten (nur hinter einem
# Reverse Proxy, der die API exklusiv erreicht). Standard: false.
TRUST_PROXY_HEADERS=false
# Optional: erlaubte Auth-Versuche je IP und 15 Minuten (Standard 10, §8).
# AUTH_RATE_LIMIT_BURST=10
