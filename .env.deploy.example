# Variablen für `docker compose` (Datei nach `.env` im Repo-Wurzelverzeichnis
# kopieren). Die API-Konfiguration selbst steht in docker-compose.yml; hier
# stehen nur die Werte, die pro Server unterschiedlich sind.

# Pflicht. Erzeugen mit:  openssl rand -base64 48
JWT_SECRET=

# Ohne HTTPS auf false setzen, sonst verwirft der Browser das Refresh-Cookie
# und die Anmeldung hält nur bis zum Neuladen.
COOKIE_SECURE=false

# Die Domain, unter der die App erreichbar ist. Bei Zugriff über eine reine
# IP-Adresse leer lassen bzw. auf localhost stehen lassen.
COOKIE_DOMAIN=localhost

# Nur nötig, wenn das Frontend von einer anderen Herkunft geladen wird als die
# API. Im Standardaufbau liefert die API das Frontend selbst aus – dann genügt
# die eigene öffentliche Adresse.
CORS_ORIGINS=http://localhost:8080

# Auf true setzen, wenn nginx (oder ein anderer Proxy) davorsteht UND die API
# nur noch auf 127.0.0.1 lauscht. Sonst kann jeder das Rate Limiting der
# Anmeldung mit einem eigenen X-Forwarded-For aushebeln.
TRUST_PROXY_HEADERS=false

# Optional
RUST_LOG=info,neuron_api=info

# Optional: erlaubte Auth-Versuche je IP und 15 Minuten (Standard 10, §8).
# Höher setzen, wenn mehrere Leute hinter derselben IP sitzen.
# AUTH_RATE_LIMIT_BURST=30
