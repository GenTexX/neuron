{
  "db_name": "PostgreSQL",
  "query": "SELECT id, game_id, mode, level, config_hash, score, correct_count, trial_count,\n                  valid, invalid_reason, submitted_at as \"submitted_at!\"\n           FROM run\n           WHERE user_id = $1\n             AND submitted_at IS NOT NULL\n             AND ($2::text IS NULL OR game_id = $2)\n             AND ($3::timestamptz IS NULL OR submitted_at < $3)\n           ORDER BY submitted_at DESC\n           LIMIT $4",
